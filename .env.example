# ==============================================================================
# Enterprise Portfolio Platform — Production Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=5001
NODE_ENV=production

# JWT Authentication Secret Key
# Provide a strong, cryptographically secure 256-bit string in production:
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_secret_in_production_at_least_32_chars

# JWT Session Lifespan (e.g., '24h', '7d', '12h')
JWT_EXPIRES_IN=24h

# Allowed CORS Origins (Comma-separated URLs, or leave blank to allow local/same-origin)
# Example: https://mansoor.tech,https://admin.mansoor.tech
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001

# Secret URL for the admin panel (REQUIRED to publish it). The admin is served only at
# https://<site>/<ADMIN_PATH>/ ; /admin is always a 404. 16-64 random lowercase letters,
# digits or dashes, and must not contain "admin", "login", "cms", "panel" or "dashboard".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PATH=

# Admin login (REQUIRED on Vercel)
# Vercel's filesystem is temporary and per-instance, so the admin cannot be created
# through the website there; online first-run setup is disabled in production.
# Generate the hash with:  npm run hash-password
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Bump this number to sign out every existing admin session.
ADMIN_TOKEN_VERSION=1

# Self-hosted production only (not Vercel): allow one-time online setup when the
# request includes this token as "setupToken". Leave empty to keep setup disabled.
ADMIN_SETUP_TOKEN=

# Local development only — ignored in production. Creates admin/admin123.
ALLOW_DEV_FALLBACK=false
